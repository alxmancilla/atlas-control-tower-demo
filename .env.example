# Copy to .env and fill in. Never commit .env.
# Atlas connection string for a NON-PRODUCTION cluster (Atlas UI > Connect > Drivers).
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>.mongodb.net/?retryWrites=true&w=majority

# Dedicated demo database. Setup, seed, reset, and cleanup only touch this database.
# The name must contain "demo" as a guard against pointing at a real database.
DEMO_DB_NAME=atlas_control_tower_demo

# Default domain profile shown in the UI: retail | healthcare | manufacturing
DEMO_PROFILE=retail

# FastAPI UI port. Default: 8000.
# PYTHON_PORT=8000

# FastAPI interface. 127.0.0.1 keeps the dashboard local-only; no admin token is
# needed and the browser never asks for one. This is the simplest setup for a demo.
# Use 0.0.0.0 to share the dashboard on the network; ADMIN_TOKEN is then required.
HOST=127.0.0.1

# Hostnames or IP addresses that may serve FastAPI, comma-separated and without
# ports. Loopback hosts are always allowed. Add this machine's LAN address before
# accessing the dashboard from another device.
# ALLOWED_HOSTS=192.0.2.10

# Required when HOST is not a loopback address. When set, every change (POST)
# needs this value and the browser prompts once per tab. Use a strong private
# value and never commit it.
# ADMIN_TOKEN=
