# Copy to .env and fill in. Never commit .env.
# Atlas connection string for a NON-PRODUCTION cluster (Atlas UI > Connect > Drivers).
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>.mongodb.net/?retryWrites=true&w=majority

# Dedicated demo database. Setup, seed, reset, and cleanup only touch this database.
# The name must contain "demo" as a guard against pointing at a real database.
DEMO_DB_NAME=atlas_control_tower_demo

# Default domain profile shown in the UI: retail | healthcare | manufacturing
DEMO_PROFILE=retail

# HTTP port for the Control Tower UI
PORT=3000

# Local Docker Kafka contract environment. The local listener is intentionally
# loopback-only and PLAINTEXT, so Atlas Stream Processing cannot use it directly.
KAFKA_TELEMETRY_TOPIC=control-tower-telemetry

# Optional Atlas Stream Processing telemetry rollups. These are non-secret
# Connection Registry labels and the same Kafka topic, not broker credentials.
ASP_TELEMETRY_ENABLED=false
ASP_KAFKA_CONNECTION=
ASP_TELEMETRY_TOPIC=control-tower-telemetry
ASP_ATLAS_CONNECTION=

# Interface to listen on. Default 127.0.0.1 (this machine only). Any other value, such as 0.0.0.0,
# exposes the write API to the network and requires ADMIN_TOKEN.
# HOST=127.0.0.1

# Optional shared secret. When set, every change (POST) needs it; the browser prompts for it once per tab.
# ADMIN_TOKEN=

# Database used by integration tests (dropped collections are limited to this database).
TEST_DB_NAME=atlas_control_tower_demo_test
