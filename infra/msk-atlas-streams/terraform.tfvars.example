# Copy to terraform.tfvars. Never commit the real file or Terraform state.
aws_region            = "us-east-1"
atlas_project_id      = "0123456789abcdef01234567"
stream_workspace_name = "controlTowerStreams"
atlas_cluster_name    = "ControlTowerDemo"

vpc_id         = "vpc-0123456789abcdef0"
msk_subnet_ids = ["subnet-0123456789abcdef0", "subnet-0abcdef1234567890"]

# Include the ASP VPC CIDR from Atlas account details and, if needed, CIDRs of
# approved producers running in your VPC. Do not use 0.0.0.0/0.
kafka_allowed_cidr_blocks = ["192.168.0.0/21"]

# Retrieve the exact full principal ARN from the Atlas Streams account-details API.
atlas_streams_principal_arn = "arn:aws:iam::123456789012:root"

name_prefix         = "control-tower-demo"
kafka_scram_username = "control_tower_asp"

# Supply this only as TF_VAR_kafka_scram_password in your shell or CI secret store.
# kafka_scram_password = "do-not-store-a-real-password-here"