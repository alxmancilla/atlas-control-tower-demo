{
  "name": "atlas-control-tower-demo",
  "version": "1.0.0",
  "private": true,
  "description": "FastAPI-first Atlas Control Tower demo: exception workflow, milestone risk, and event reliability for retail, healthcare, and manufacturing profiles.",
  "main": "src/server.js",
  "scripts": {
    "start": "cd python && uv run --env-file ../.env python -m app.run",
    "start:node": "node --env-file-if-exists=.env src/server.js",
    "setup": "node --env-file-if-exists=.env src/cli.js setup",
    "search:create": "node --env-file-if-exists=.env src/cli.js search-create",
    "search:status": "node --env-file-if-exists=.env src/cli.js search-status",
    "check": "node --env-file-if-exists=.env src/cli.js check",
    "reset": "node --env-file-if-exists=.env src/cli.js reset",
    "reanchor": "node --env-file-if-exists=.env src/cli.js reanchor",
    "stream:processor": "node --env-file-if-exists=.env src/streamProcessorCli.js",
    "stream:processor:check": "node --env-file-if-exists=.env src/streamProcessorCli.js > /dev/null",
    "kafka:up": "node --env-file-if-exists=.env src/kafkaLocalCli.js up",
    "kafka:down": "node --env-file-if-exists=.env src/kafkaLocalCli.js down",
    "kafka:logs": "node --env-file-if-exists=.env src/kafkaLocalCli.js logs",
    "kafka:publish": "node --env-file-if-exists=.env src/kafkaLocalCli.js publish",
    "kafka:verify": "node --env-file-if-exists=.env src/kafkaLocalCli.js verify",
    "kafka:public:prepare": "bash scripts/kafka-public-prepare.sh",
    "kafka:public:up": "node --env-file-if-exists=.env src/kafkaPublicCli.js up",
    "kafka:public:down": "node --env-file-if-exists=.env src/kafkaPublicCli.js down",
    "kafka:public:logs": "node --env-file-if-exists=.env src/kafkaPublicCli.js logs",
    "kafka:public:publish": "node --env-file-if-exists=.env src/kafkaPublicCli.js publish",
    "kafka:public:verify": "node --env-file-if-exists=.env src/kafkaPublicCli.js verify",
    "kafka:public:certificate": "node --env-file-if-exists=.env src/kafkaPublicCli.js certificate",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/integration/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "mongodb": "^7.8.0"
  }
}
